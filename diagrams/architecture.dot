digraph Architecture {
    rankdir=LR;
    bgcolor="white";
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.25,0.15"];
    edge [fontname="Helvetica", fontsize=10, color="#555555"];

    Client [label="Task Submitter\n(Main.java / tasks.txt)", fillcolor="#E6F1FB", color="#185FA5"];
    Queue [label="Task Queue Manager\n(PriorityBlockingQueue)", fillcolor="#EEEDFE", color="#534AB7"];
    Executor [label="Task Executor Service\n(ExecutorService + Workers)", fillcolor="#E1F5EE", color="#0F6E56"];
    Logger [label="File Task Logger\n(taskflow-log.csv)", fillcolor="#FAEEDA", color="#854F0B"];
    Report [label="Performance Report\nGenerator", fillcolor="#FAECE7", color="#993C1D"];

    Client -> Queue [label="submit(Task)"];
    Queue -> Executor [label="takeNext()"];
    Executor -> Logger [label="logEvent()"];
    Executor -> Report [label="processedTasks"];
    Report -> Client [label="taskflow-report.txt", style=dashed];
}
