digraph ClassDiagram {
    rankdir=TB;
    bgcolor="white";
    node [shape=record, fontname="Helvetica", fontsize=10, style=filled, fillcolor="#F1EFE8"];
    edge [fontname="Helvetica", fontsize=9, color="#555555", arrowhead=vee];

    Task [label="{Task|+ id: long\l+ name: String\l+ priority: int\l+ estimatedDurationMillis: long\l+ status: TaskStatus\l+ submittedAt: Instant\l+ retryCount: int\l|+ markStarted()\l+ markCompleted()\l+ markFailed()\l+ getWaitTimeMillis(): long\l+ getExecutionTimeMillis(): long\l}"];

    TaskStatus [label="{\<\<enum\>\>\nTaskStatus|SUBMITTED\lQUEUED\lRUNNING\lRETRYING\lCOMPLETED\lFAILED\l}", fillcolor="#EEEDFE"];

    TaskPriorityComparator [label="{TaskPriorityComparator|\<\<implements Comparator\<Task\>\>\>|+ compare(t1, t2): int\l}"];

    TaskQueueManager [label="{TaskQueueManager|- queue: PriorityBlockingQueue\<Task\>\l|+ submit(task): void\l+ takeNext(): Task\l+ size(): int\l}", fillcolor="#E6F1FB"];

    TaskExecutorService [label="{TaskExecutorService|- pool: ExecutorService\l- processedTasks: List\<Task\>\l- completedCount: AtomicInteger\l- failedCount: AtomicInteger\l|+ start(queueManager, logger): void\l+ shutdown(timeout): void\l+ getProcessedTasks(): List\<Task\>\l}", fillcolor="#E1F5EE"];

    Worker [label="{Worker|\<\<implements Runnable\>\>\>|+ run(): void\l- processWithRetry(task): void\l- execute(task): void\l}", fillcolor="#E1F5EE"];

    TaskLogger [label="{\<\<interface\>\>\nTaskLogger||+ logEvent(task, event): void\l}", fillcolor="#FAEEDA"];

    FileTaskLogger [label="{FileTaskLogger|- writer: PrintWriter\l|+ logEvent(task, event): void\l+ close(): void\l}", fillcolor="#FAEEDA"];

    PerformanceReportGenerator [label="{PerformanceReportGenerator||+ generate(tasks, duration, path): void\l}", fillcolor="#FAECE7"];

    InvalidTaskException [label="{\<\<exception\>\>\nInvalidTaskException}", fillcolor="#FCEBEB"];
    TaskExecutionException [label="{\<\<exception\>\>\nTaskExecutionException}", fillcolor="#FCEBEB"];

    Task -> TaskStatus [label="has a", style=dashed, arrowhead=vee];
    TaskQueueManager -> Task [label="manages *"];
    TaskQueueManager -> TaskPriorityComparator [label="uses"];
    TaskQueueManager -> InvalidTaskException [label="throws", style=dashed];
    TaskExecutorService -> Worker [label="spawns *"];
    Worker -> TaskQueueManager [label="pulls from"];
    Worker -> TaskLogger [label="logs via"];
    Worker -> TaskExecutionException [label="throws", style=dashed];
    FileTaskLogger -> TaskLogger [label="implements", arrowhead=empty, style=dashed];
    PerformanceReportGenerator -> Task [label="reads *"];
}
