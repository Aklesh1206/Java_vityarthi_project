digraph Workflow {
    rankdir=TB;
    bgcolor="white";
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.25,0.15"];
    edge [fontname="Helvetica", fontsize=10, color="#555555"];

    Submitted [label="SUBMITTED\n(validated & created)", fillcolor="#E6F1FB", color="#185FA5"];
    Queued [label="QUEUED\n(waiting in priority queue)", fillcolor="#EEEDFE", color="#534AB7"];
    Running [label="RUNNING\n(picked up by a worker thread)", fillcolor="#FAEEDA", color="#854F0B"];
    Decision [shape=diamond, label="Execution\nsucceeded?", fillcolor="#F1EFE8", color="#5F5E5A", style=filled];
    Completed [label="COMPLETED\n(logged + counted)", fillcolor="#E1F5EE", color="#0F6E56"];
    Retrying [label="RETRYING\n(1 retry attempt)", fillcolor="#FAECE7", color="#993C1D"];
    Decision2 [shape=diamond, label="Retry\nsucceeded?", fillcolor="#F1EFE8", color="#5F5E5A", style=filled];
    Failed [label="FAILED\n(logged + counted)", fillcolor="#FCEBEB", color="#A32D2D"];

    Submitted -> Queued;
    Queued -> Running [label="worker calls takeNext()"];
    Running -> Decision;
    Decision -> Completed [label="yes"];
    Decision -> Retrying [label="no"];
    Retrying -> Decision2;
    Decision2 -> Completed [label="yes"];
    Decision2 -> Failed [label="no"];
}
