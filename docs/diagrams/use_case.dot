digraph UseCase {
    rankdir=LR;
    bgcolor="white";
    node [fontname="Helvetica", fontsize=12];
    edge [color="#555555"];

    Student [shape=box, style="rounded,filled", fillcolor="#FAEEDA", color="#854F0B", label="Student /\nSystem Operator", fontsize=13];

    node [shape=ellipse, style=filled, fillcolor="#E6F1FB", color="#185FA5", margin="0.15,0.1"];
    UC1 [label="Submit Tasks\n(via tasks.txt)"];
    UC2 [label="Configure Thread\nPool Size"];
    UC3 [label="View Execution Log\n(taskflow-log.csv)"];
    UC4 [label="View Performance\nReport"];
    UC5 [label="Run Validation\nTests"];

    Student -> UC1;
    Student -> UC2;
    Student -> UC3;
    Student -> UC4;
    Student -> UC5;
}
