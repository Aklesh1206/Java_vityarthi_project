<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.taskflow</groupId>
    <artifactId>taskflow</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>TaskFlow</name>
    <description>Multi-threaded Job Queue Simulator built for the VITyarthi "Build Your Own Project" submission (Programming in Java).</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <finalName>taskflow</finalName>
        <plugins>
            <!-- Compiles src/main/java and src/test/java -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!--
                TaskFlowValidationTest is a plain, dependency-free assertion runner
                (no JUnit/TestNG), written this way so it has zero external
                dependencies and always compiles offline. Surefire's default
                test-discovery would otherwise try (and fail) to run it as a
                JUnit test purely because its name matches *Test.java.
                Run it directly instead: see README "Instructions for Testing".
                To wire up `mvn test` properly, add the JUnit 5 dependency
                below and convert the assertions to @Test methods.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <skipTests>true</skipTests>
                </configuration>
            </plugin>

            <!-- Lets you run the app with: mvn exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>com.taskflow.Main</mainClass>
                    <arguments>
                        <argument>config/tasks.txt</argument>
                        <argument>4</argument>
                    </arguments>
                </configuration>
            </plugin>

            <!-- Packages a runnable jar with the manifest Main-Class set -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.taskflow.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
